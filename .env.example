# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloudinary Configuration for video storage and streaming
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# MongoDB Connection String (e.g. mongodb+srv://user:pass@cluster.mongodb.net/shortvideo)
# If empty, the app uses an integrated high-performance persistent storage engine.
MONGODB_URI=""

# Admin Authentication
ADMIN_EMAIL="admin@shortvideo.com"
ADMIN_PASSWORD="admin_secure_password"
ADMIN_JWT_SECRET="short_video_jwt_secret_key_2026"

# PhonePe & UPI Configuration
UPI_ID="shortvideo@upi"
UPI_NAME="Short Video Media"
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
PHONEPE_SALT_INDEX="1"
